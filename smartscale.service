[Unit]
Description=Smart Weight Scale Application
After=graphical.target network.target
Wants=graphical.target

[Service]
Type=simple
User=melody
WorkingDirectory=/home/melody/smartscale
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/melody/.Xauthority
ExecStart=/usr/bin/python3 /home/melody/smartscale/launcher.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/melody/smartscale/scale.log
StandardError=append:/home/melody/smartscale/scale.log

[Install]
WantedBy=graphical.target
